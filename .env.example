# 이 파일을 복사해서 이름을 .env 로 바꾸고, 값을 채워 쓰세요.
# (.env 는 .gitignore 로 GitHub 에 올라가지 않아요. 이 견본에는 진짜 키를 적지 마세요!)

# GPT 호출 키 (코디세이 게이트웨이)
CODYSSEY_API_KEY=여기에_GPT_키

# KOSIS 국가통계포털 인증키 (인구 갱신용)
KOSIS_API_KEY=여기에_KOSIS_인증키

# [로컬] Firebase 서비스계정 키 파일 경로
FIREBASE_KEY_PATH=serviceAccountKey.json

# [배포: Render] 위 FIREBASE_KEY_PATH 대신, 서비스계정 JSON "전체 내용"을 아래에 넣어요
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- 선택 설정 (안 적으면 기본값) ----
# CORS 허용 주소 (쉼표로 여러 개). 안 적으면 * (모두 허용)
# ALLOWED_ORIGINS=https://ai-secretary-omega-eight.vercel.app
# 추세 비교 기간(일). 기본 30
# SUMMARY_RECENT_DAYS=30
# GPT 답변 길이 상한(비용 보호). 안 적으면 제한 없음
# MAX_TOKENS=6000
